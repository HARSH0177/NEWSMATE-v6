# ============================================================
# NewsMate Production Environment Configuration Example
# Copy this file to .env and insert your authorized API keys.
# ============================================================

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# Gemini API Key Pool (Comma-separated keys for auto round-robin rate-limit rotation)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Single Gemini Key Fallback (Optional if GEMINI_API_KEYS is specified)
GEMINI_API_KEY=your_single_gemini_api_key

# News Search Provider API Keys (Optional)
NEWS_API_KEY=your_newsapi_org_key_optional
GNEWS_API_KEY=your_gnews_io_key_optional

# Playwright Scraper Timeout (milliseconds)
SCRAPER_TIMEOUT_MS=15000
